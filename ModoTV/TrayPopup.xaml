<Window x:Class="ModoTV.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo TV" Width="344" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#F2F2F4">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12" RenderTransformOrigin="0.5,1" TextElement.Foreground="#F2F2F4" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="12">
        <Grid.RenderTransform><TranslateTransform x:Name="Lift"/></Grid.RenderTransform>
        <!-- Sombra separada para não borrar o texto -->
        <Border CornerRadius="20" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="#3C3C41" BorderThickness="1">
            <StackPanel Margin="12,12,12,10">

                <!-- Cabeçalho -->
                <Grid Margin="2,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="#24324A">
                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="#7DB4FF" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2.5,4.5 H21.5 V16.5 H2.5 Z M7.5,20 L9.5,16.5 M16.5,20 L14.5,16.5"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="TV do quarto" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="SubtitleText" Text="" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource Round}" Width="30" Height="30"
                            Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Accent}"
                            Margin="0,0,6,0" ToolTip="Mais opções">
                        <TextBlock Text="•••" FontSize="10" Margin="0,0,0,1"/>
                    </Button>
                    <Button x:Name="PowerButton" Grid.Column="3" Style="{StaticResource Round}" Width="36" Height="36"
                            Background="#22344F" BorderBrush="#2F4A70" Foreground="#7DB4FF" ToolTip="Ligar/desligar o modo TV">
                        <Path Style="{StaticResource Glyph}" Width="15" Height="15" StrokeThickness="1.9"
                              Data="M12,3 V11 M7.2,6.4 A7.5,7.5 0 1 0 16.8,6.4"/>
                    </Button>
                </Grid>

                <!-- Aviso de versão nova (GitHub) -->
                <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="12" Background="#1E3350"
                        BorderBrush="#3A6DB3" BorderThickness="1" Padding="12,9" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="UpdateTitle" Text="Nova versão disponível" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock x:Name="UpdateText" Foreground="#9FC4F5" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource Primary}" Width="98" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateButtonText" Text="Atualizar" FontSize="12.5" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Destaque: a TV -->
                <Border Style="{StaticResource CardBox}" Padding="12,10,12,12">
                    <StackPanel>
                        <Viewbox Height="92" HorizontalAlignment="Center">
                            <Canvas Width="240" Height="150">
                                <!-- brilho atrás da TV quando ligada -->
                                <Ellipse x:Name="TvGlow" Canvas.Left="10" Canvas.Top="18" Width="220" Height="120" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#664C7DFF" Offset="0"/>
                                            <GradientStop Color="#224C7DFF" Offset="0.55"/>
                                            <GradientStop Color="#004C7DFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- pés em V nas pontas, como nas TCL -->
                                <Path Stroke="#55555C" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M38,128 L28,144 M38,128 L48,144 M202,128 L192,144 M202,128 L212,144"/>
                                <Path Stroke="#2A2A2E" StrokeThickness="1" Data="M20,145.5 H220"/>
                                <!-- moldura -->
                                <Border Canvas.Left="14" Canvas.Top="8" Width="212" Height="124" CornerRadius="5"
                                        Background="#0B0B0D" BorderBrush="#3A3A40" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="9"/>
                                        </Grid.RowDefinitions>
                                        <!-- tela -->
                                        <Border Margin="3,3,3,0" CornerRadius="2" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle x:Name="ScreenOff">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#1C1C21" Offset="0"/>
                                                            <GradientStop Color="#111114" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle x:Name="ScreenOn" Opacity="0">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0E2A6B" Offset="0"/>
                                                            <GradientStop Color="#2D5BD8" Offset="0.38"/>
                                                            <GradientStop Color="#7A3FD1" Offset="0.72"/>
                                                            <GradientStop Color="#D2457F" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Ellipse x:Name="ScreenBloom" Width="150" Height="90" Margin="-20,-30,0,0"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <!-- reflexo diagonal -->
                                                <Path Data="M0,0 L120,0 L60,120 L0,120 Z" Opacity="0.06" Fill="White"/>
                                                <TextBlock x:Name="ScreenLabel" Text="HDMI" Foreground="#D9E6FF" FontSize="15"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                                                <Border CornerRadius="3" Background="#CC0B0B0D" BorderBrush="#334C9BFF" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="5,1">
                                                    <TextBlock x:Name="ResolutionBadge" Text="4K" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="BrandText" Grid.Row="1" Text="" FontSize="5.5" FontWeight="Bold" Foreground="#9A9AA2"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                        <Ellipse x:Name="PowerLed" Grid.Row="1" Width="2" Height="2" Fill="#E0453A"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Viewbox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource Muted}">
                                Monitores <Run x:Name="MonitorsRun" Text="2 ativos" Foreground="#F2F2F4" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="14,0,0,0" Foreground="{StaticResource Muted}">
                                TV <Run x:Name="TvRun" Text="em espera" Foreground="#F2F2F4" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock x:Name="ModeTag" Grid.Column="2" Text="MESA" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                        </Grid>

                        <TextBlock x:Name="BigText" Text="Na mesa" FontSize="26" FontWeight="Light" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BigSub" Text="AOC 25G4S + LG UltraGear" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Button x:Name="SwitchButton" Style="{StaticResource Primary}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="SwitchIcon" Width="16" Height="16" Stretch="Uniform" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M2.5,4.5 H21.5 V16.5 H2.5 Z M7.5,20 L9.5,16.5 M16.5,20 L14.5,16.5"/>
                                <TextBlock x:Name="SwitchText" Text="Ir para a TV" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Modo e opções -->
                <Border Style="{StaticResource CardBox}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Modo" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="DeskTile" Style="{StaticResource Tile}" Margin="0,0,4,0" Padding="0,7" Tag="on">
                                <StackPanel>
                                    <Path Style="{StaticResource Glyph}" Width="22"
                                          Data="M1.5,5 H10.5 V12.5 H1.5 Z M13.5,5 H22.5 V12.5 H13.5 Z M6,12.5 V16 M18,12.5 V16 M3.5,16 H8.5 M15.5,16 H20.5"/>
                                    <TextBlock Text="Mesa" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TvTile" Style="{StaticResource Tile}" Margin="4,0,0,0" Padding="0,7">
                                <StackPanel>
                                    <Path Style="{StaticResource Glyph}" Width="22"
                                          Data="M2.5,4.5 H21.5 V16.5 H2.5 Z M7.5,20 L9.5,16.5 M16.5,20 L14.5,16.5"/>
                                    <TextBlock Text="TV" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="Resolução na TV" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <!-- Opções montadas a partir dos modos que a TV oferece. Clicar na escolhida volta para automático. -->
                        <UniformGrid x:Name="PresetGrid" Columns="2">
                            <Button x:Name="PresetA" Style="{StaticResource Tile}" Margin="0,0,4,0" Padding="0,7"
                                    ToolTip="Máxima nitidez">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PresetARes" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PresetAHz" FontSize="11.5" Opacity="0.75" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PresetB" Style="{StaticResource Tile}" Margin="4,0,0,0" Padding="0,7"
                                    ToolTip="Mais fluido e mais leve para a placa de vídeo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PresetBRes" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PresetBHz" FontSize="11.5" Opacity="0.75" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock x:Name="PresetHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="As opções aparecem depois da primeira vez no modo TV. Até lá, a TV usa a resolução recomendada pelo Windows."/>

                        <Grid Margin="0,10,0,8">
                            <TextBlock Text="Áudio" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AudioText" Text="Realtek" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                        <UniformGrid Columns="3">
                            <Button x:Name="AudioChip" Style="{StaticResource Tile}" Margin="0,0,4,0" Padding="0,6" Tag="on"
                                    ToolTip="Levar o som para a TV junto com a imagem">
                                <StackPanel>
                                    <Path Style="{StaticResource Glyph}" Width="17" Height="17"
                                          Data="M3.5,9 H7.5 L12.5,5 V19 L7.5,15 H3.5 Z M16,9.2 A4,4 0 0 1 16,14.8 M18.6,6.6 A7.6,7.6 0 0 1 18.6,17.4"/>
                                    <TextBlock Text="Som junto" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartupChip" Style="{StaticResource Tile}" Margin="4,0,4,0" Padding="0,6"
                                    ToolTip="Abrir o Modo TV junto com o Windows">
                                <StackPanel>
                                    <Path Style="{StaticResource Glyph}" Width="15" Height="17"
                                          Data="M3,3 H10.8 V10.8 H3 Z M13.2,3 H21 V10.8 H13.2 Z M3,13.2 H10.8 V21 H3 Z M13.2,13.2 H21 V21 H13.2 Z"/>
                                    <TextBlock Text="Ao ligar o PC" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PadChip" Style="{StaticResource Tile}" Margin="4,0,0,0" Padding="0,6" Tag="on"
                                    ToolTip="Trocar segurando Select + Start no controle">
                                <StackPanel>
                                    <Path Style="{StaticResource Glyph}" Width="20" Height="17"
                                          Data="M7.5,7 H16.5 A4.5,4.5 0 0 1 21,11.2 L21.7,15.6 A2.6,2.6 0 0 1 17.2,17.6 L15.3,15.5 H8.7 L6.8,17.6 A2.6,2.6 0 0 1 2.3,15.6 L3,11.2 A4.5,4.5 0 0 1 7.5,7 Z M7.5,9.8 V12.8 M6,11.3 H9 M16,10.3 L16,10.3 M17.8,12.3 L17.8,12.3"/>
                                    <TextBlock Text="Controle" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Rodapé -->
                <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                    <Grid Width="15" Height="15">
                        <Ellipse Stroke="{StaticResource Muted}" StrokeThickness="1.2"/>
                        <Path Stroke="{StaticResource Muted}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4.3,7.7 L6.6,10 L10.8,5.4"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Segure Select + Start ou Ctrl+Alt+F11" Foreground="{StaticResource Muted}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Height="1" Fill="#2C2C30" Margin="0,8,0,7"/>
                <Grid Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PadDot" Width="6" Height="6" Fill="#3DD07A" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PadText" Text="Nenhum controle conectado" Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Text="v1.1.0" HorizontalAlignment="Right" Foreground="{StaticResource Dim}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
